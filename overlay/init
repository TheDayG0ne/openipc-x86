#!/bin/sh
# Early init for a read-only x86 root. Never format or repair a disk.
PATH=/sbin:/bin:/usr/sbin:/usr/bin
export PATH
. /usr/libexec/overlay-x86

fail() {
    echo "overlay-x86: $*; starting emergency shell" >&2
    exec /bin/sh
}

mount -t proc proc /proc || fail 'cannot mount proc'
mount -t devtmpfs devtmpfs /dev || fail 'cannot mount devtmpfs'
# Avoid ever mounting the root device writable as the data store.
awk '$2 == "/" && $3 == "squashfs" && $4 ~ /(^|,)ro(,|$)/ {ok=1} END {exit !ok}' /proc/mounts || fail 'root must be read-only squashfs'
mkdir -p /overlay /mnt /rom

device=
for arg in $(cat /proc/cmdline); do
    case "$arg" in overlay.x86=*)
        [ -z "$device" ] || fail 'duplicate overlay.x86'
        device=${arg#overlay.x86=}
        ;;
    esac
done
case "$device" in /dev/*) ;; *) fail 'overlay.x86 must name a /dev block device' ;; esac
[ -b "$device" ] || fail 'overlay device absent or not a block device'
# Explicit provisioning is mandatory; an unmountable disk is never reformatted.
mount -t ext4 -o rw,nodev,nosuid "$device" /overlay || fail 'cannot mount persistent ext4'
ovl_prepare /overlay || fail 'invalid or incomplete overlay store'
mount -t overlay overlay -o lowerdir=/,upperdir=/overlay/upper,workdir=/overlay/work /mnt || fail 'cannot mount overlayfs'
mkdir -p /mnt/rom /mnt/overlay /mnt/proc /mnt/dev
pivot_root /mnt /mnt/rom || fail 'pivot_root failed'
mount --move /rom/proc /proc || fail 'moving proc failed'
mount --move /rom/dev /dev || fail 'moving dev failed'
mount --move /rom/overlay /overlay || fail 'moving overlay store failed'
exec /sbin/init
