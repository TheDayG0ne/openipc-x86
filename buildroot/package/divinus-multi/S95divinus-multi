#!/bin/sh
# Start only real UVC devices. This does not emulate or substitute a camera.
# Divinus reads its config beside the executable, so each instance gets a private
# directory and config. Ports are independent; ONVIF remains disabled unless the
# operator explicitly enables it (WS-Discovery multicast is shared by design).

DAEMON=${DAEMON:-/usr/bin/divinus}
BASE=${BASE:-/var/lib/divinus-multi}
CONF=${CONF:-/etc/divinus-multi.conf}
PIDS=${PIDS:-/var/run/divinus-multi}
TEMPLATE=${TEMPLATE:-/etc/divinus.yaml}

[ -r "$CONF" ] || exit 0
. "$CONF"

pidfile() { echo "$PIDS/$1.pid"; }
stop_one() {
    p=$(pidfile "$1")
    [ -r "$p" ] || return 0
    pid=$(cat "$p")
    kill "$pid" 2>/dev/null || true
    rm -f "$p"
}
start_one() {
    n=$1; dev=$2; web=$3; rtsp=$4
    [ -n "$web" ] || web=$((79 + n))
    [ -n "$rtsp" ] || rtsp=$((553 + n))
    # Instance 1 is the setup anchor and must exist without a camera. Additional
    # instances are strictly device-backed; this is not a hotplug supervisor.
    if [ "$n" -ne 1 ] && { [ -z "$dev" ] || [ ! -c "$dev" ]; }; then
        echo "divinus-multi: camera $n absent ($dev), skipped" >&2
        return 0
    fi
    dir="$BASE/$n"
    mkdir -p "$dir" "$PIDS" || return 1
    [ -n "$dev" ] || dev=/dev/null
    # Divinus resolves its config beside /proc/self/exe. Change only the keys
    # in their owning YAML sections; a global `port:` replacement is unsafe.
    awk -v web="$web" -v rtsp="$rtsp" '
        /^system:$/ { section="system" }
        /^rtsp:$/ { section="rtsp" }
        section == "system" && /^  web_port:/ { $0="  web_port: " web }
        section == "rtsp" && /^  port:/ { $0="  port: " rtsp }
        { print }
    ' "$TEMPLATE" > "$dir/divinus.yaml" || return 1
    cp "$DAEMON" "$dir/divinus" || return 1
    UVC_DEVICE="$dev" "$dir/divinus" >"$dir/divinus.log" 2>&1 &
    echo $! > "$(pidfile "$n")"
}

case "$1" in
 start)
    mkdir -p "$BASE" "$PIDS"
    count=${MULTI_CAMERAS:-1}; [ "$count" -ge 1 ] 2>/dev/null || count=1
    [ "$count" -le 4 ] 2>/dev/null || count=4
    i=1
    while [ "$i" -le "$count" ]; do
        eval "dev=\${MULTI_DEVICE_$i}"; eval "web=\${MULTI_WEB_PORT_$i}"; eval "rtsp=\${MULTI_RTSP_PORT_$i}"
        start_one "$i" "$dev" "$web" "$rtsp"
        i=$((i + 1))
    done
    ;;
 stop)
    i=1; while [ "$i" -le 4 ]; do stop_one "$i"; i=$((i + 1)); done
    ;;
 restart) "$0" stop; sleep 1; "$0" start ;;
 *) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
 esac
