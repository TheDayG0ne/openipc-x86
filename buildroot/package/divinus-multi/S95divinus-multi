#!/bin/sh
# Run one camera-independent Divinus WebUI/API process and camera workers without
# HTTP listeners. Workers retain only their RTSP endpoints.

DAEMON=${DAEMON:-/usr/bin/divinus}
BASE=${BASE:-/var/lib/divinus-multi}
CONF=${CONF:-/etc/divinus-multi.conf}
PIDS=${PIDS:-/var/run/divinus-multi}
TEMPLATE=${TEMPLATE:-/etc/divinus.yaml}
RUNTIME=${RUNTIME:-/run/divinus}
MANIFEST=$RUNTIME/cameras.manifest
STOP_TIMEOUT=${STOP_TIMEOUT:-5}

# stop is deliberately useful during recovery even when the configuration was
# removed. start still has the historical, quiet no-config behaviour.
case "$1" in
    stop|restart) ;;
    *) [ -r "$CONF" ] || exit 0; . "$CONF" ;;
esac

umask 077
pidfile() { echo "$PIDS/$1.pid"; }
# Field 22 follows the parenthesized comm field, which may contain spaces or ')'.
starttime() {
    [ -r "/proc/$1/stat" ] || return 1
    stat=$(cat "/proc/$1/stat") || return 1
    stat=${stat##*) }
    set -- $stat
    [ "$#" -ge 20 ] || return 1
    shift 19
    case $1 in ''|*[!0-9]*) return 1;; esac
    printf '%s\n' "$1"
}
owned_pid() {
    [ -f "$1" ] && [ ! -L "$1" ] || return 1
    read -r pid started extra < "$1" || return 1
    case $pid in ''|*[!0-9]*|0|1) return 1;; esac
    case $started in ''|*[!0-9]*) return 1;; esac
    [ -z "$extra" ] || return 1
    actual=$(starttime "$pid") || return 1
    [ "$actual" = "$started" ]
}
# /proc starttime guards against stale PID files, but checking then signalling
# is not atomic: PID reuse between the check and kill remains possible. A zombie
# may also keep its pidfile until reaped. This is not a pidfd-based supervisor.
stop_one() {
    name=$1; p=$(pidfile "$name")
    if ! owned_pid "$p"; then
        rm -f "$p"
        return 0
    fi
    read -r pid started < "$p" || return 1
    if ! kill "$pid" 2>/dev/null; then
        echo "divinus-multi: cannot stop $name (pid $pid); pidfile retained" >&2
        return 1
    fi
    waited=0
    while owned_pid "$p" && [ "$waited" -lt "$STOP_TIMEOUT" ]; do
        sleep 1
        waited=$((waited + 1))
    done
    if owned_pid "$p"; then
        echo "divinus-multi: timeout stopping $name (pid $pid); pidfile retained" >&2
        return 1
    fi
    rm -f "$p"
}
stop_all() {
    failed=0
    stop_one central || failed=1
    i=1
    while [ "$i" -le 4 ]; do stop_one "camera-$i" || failed=1; i=$((i + 1)); done
    [ "$failed" -eq 0 ]
}
secure_dir() {
    [ ! -L "$1" ] || return 1
    mkdir -p "$1" || return 1
    [ -d "$1" ] && [ ! -L "$1" ] || return 1
    [ "$(stat -c %u "$1")" = "$(id -u)" ] || return 1
    chmod 700 "$1"
}
record_child() {
    child=$1; file=$2
    started=$(starttime "$child") || { kill "$child" 2>/dev/null || true; return 1; }
    printf '%s %s\n' "$child" "$started" > "$file" || { kill "$child" 2>/dev/null || true; rm -f "$file"; return 1; }
}
# Store ports in canonical decimal form. This avoids shell arithmetic treating
# values such as 008 as octal, and makes generated manifests deterministic.
normalize_port() {
    value=$2
    case "$value" in ''|*[!0-9]*) echo "divinus-multi: invalid $1 port" >&2; return 1;; esac
    while [ "${value#0}" != "$value" ]; do value=${value#0}; done
    [ -n "$value" ] || value=0
    [ "$value" -ge 1 ] 2>/dev/null && [ "$value" -le 65535 ] 2>/dev/null || { echo "divinus-multi: $1 port out of range: $2" >&2; return 1; }
    NORMALIZED_PORT=$value
}
validate_config() {
    normalize_port web "$MULTI_WEB_PORT" || return 1; MULTI_WEB_PORT=$NORMALIZED_PORT
    normalize_port central-RTSP "$MULTI_RTSP_PORT_CENTRAL" || return 1; MULTI_RTSP_PORT_CENTRAL=$NORMALIZED_PORT
    [ "$MULTI_WEB_PORT" != "$MULTI_RTSP_PORT_CENTRAL" ] || { echo "divinus-multi: duplicate port $MULTI_WEB_PORT" >&2; return 1; }
    ports="$MULTI_WEB_PORT $MULTI_RTSP_PORT_CENTRAL"
    devices=""
    i=1
    while [ "$i" -le "$count" ]; do
        eval "rtsp=\${MULTI_RTSP_PORT_$i}"
        [ -n "$rtsp" ] || rtsp=$((553 + i))
        normalize_port "slot $i RTSP" "$rtsp" || return 1; rtsp=$NORMALIZED_PORT
        eval "MULTI_RTSP_PORT_$i=\$rtsp"
        case " $ports " in *" $rtsp "*) echo "divinus-multi: duplicate port $rtsp" >&2; return 1;; esac
        ports="$ports $rtsp"
        eval "device=\${MULTI_DEVICE_$i-}"
        if [ -n "$device" ]; then
            case " $devices " in *" $device "*) echo "divinus-multi: duplicate device in slot $i: $device" >&2; return 1;; esac
            devices="$devices $device"
        fi
        i=$((i + 1))
    done
}
write_manifest() {
    tmp=$(mktemp "$RUNTIME/cameras.manifest.tmp.XXXXXX") || return 1
    i=1
    while [ "$i" -le "$count" ]; do
        eval "rtsp=\${MULTI_RTSP_PORT_$i}"
        [ -n "$rtsp" ] || rtsp=$((553 + i))
        printf 'slot=%s rtsp_port=%s\n' "$i" "$rtsp" >> "$tmp" || { rm -f "$tmp"; return 1; }
        i=$((i + 1))
    done
    chown 0:0 "$tmp" 2>/dev/null || true
    chmod 600 "$tmp" || { rm -f "$tmp"; return 1; }
    mv -f "$tmp" "$MANIFEST" || { rm -f "$tmp"; return 1; }
}
write_config() {
    dir=$1; web=$2; rtsp=$3; rtsp_enable=$4
    awk -v web="$web" -v rtsp="$rtsp" -v rtsp_enable="$rtsp_enable" '
        /^system:$/ { section="system" }
        /^rtsp:$/ { section="rtsp" }
        section == "system" && /^  web_port:/ { $0="  web_port: " web }
        section == "rtsp" && /^  enable:/ { $0="  enable: " rtsp_enable }
        section == "rtsp" && /^  port:/ { $0="  port: " rtsp }
        { print }
    ' "$TEMPLATE" > "$dir/divinus.yaml" || return 1
    cp "$DAEMON" "$dir/divinus" || return 1
}
start_central() {
    dir="$BASE/central"; secure_dir "$dir" || return 1
    write_config "$dir" "$MULTI_WEB_PORT" "$MULTI_RTSP_PORT_CENTRAL" "false" || return 1
    UVC_DEVICE=/dev/null "$dir/divinus" 9>&- >"$dir/divinus.log" 2>&1 &
    record_child "$!" "$(pidfile central)"
}
start_camera() {
    n=$1; dev=$2; rtsp=$3
    [ -n "$rtsp" ] || rtsp=$((553 + n))
    if [ -z "$dev" ] || [ ! -c "$dev" ]; then echo "divinus-multi: camera $n absent ($dev), skipped" >&2; return 0; fi
    dir="$BASE/camera-$n"; secure_dir "$dir" || return 1
    write_config "$dir" 0 "$rtsp" true || return 1
    UVC_DEVICE="$dev" "$dir/divinus" 9>&- >"$dir/divinus.log" 2>&1 &
    record_child "$!" "$(pidfile "camera-$n")"
}
acquire_lock() {
    if command -v flock >/dev/null 2>&1; then
        exec 9>"$PIDS/.lock" || return 1
        flock -n 9 || { echo "divinus-multi: launcher busy" >&2; return 1; }
        LOCK_FLOCK=1
    else
        # A mkdir lock is fail-closed if flock is unavailable: never reclaim it
        # automatically, since checking an owner then removing it races another
        # launcher. After a crash, an operator must verify no launcher is running
        # before removing this empty directory.
        mkdir "$PIDS/.lock" 2>/dev/null || { echo "divinus-multi: launcher busy or stale lock; check before removing $PIDS/.lock" >&2; return 1; }
    fi
    trap 'rmdir "$PIDS/.lock" 2>/dev/null || true' EXIT
}
case "$1" in
 start)
    secure_dir "$BASE" && secure_dir "$PIDS" && secure_dir "$RUNTIME" || { echo "divinus-multi: unsafe runtime directory" >&2; exit 1; }
    acquire_lock || exit 1
    if owned_pid "$(pidfile central)"; then echo "divinus-multi: central is already running; worker reconciliation is not implemented" >&2; exit 1; fi
    count=${MULTI_CAMERAS:-0}; case "$count" in ''|*[!0-9]*) echo "divinus-multi: invalid camera count" >&2; exit 1;; esac
    while [ "${count#0}" != "$count" ]; do count=${count#0}; done; [ -n "$count" ] || count=0
    [ "$count" -le 4 ] 2>/dev/null || { echo "divinus-multi: too many cameras" >&2; exit 1; }
    MULTI_WEB_PORT=${MULTI_WEB_PORT:-80}; MULTI_RTSP_PORT_CENTRAL=${MULTI_RTSP_PORT_CENTRAL:-554}
    validate_config || exit 1
    stop_all || { echo "divinus-multi: refusing to start after incomplete stop" >&2; exit 1; }
    rm -f "$MANIFEST"
    write_manifest || exit 1
    if ! start_central; then rm -f "$MANIFEST"; exit 1; fi
    i=1
    while [ "$i" -le "$count" ]; do
        eval "dev=\${MULTI_DEVICE_$i-}"; eval "rtsp=\${MULTI_RTSP_PORT_$i}"
        if ! start_camera "$i" "$dev" "$rtsp"; then stop_all || true; rm -f "$MANIFEST"; exit 1; fi
        i=$((i + 1))
    done
    ;;
 stop)
    secure_dir "$PIDS" && secure_dir "$RUNTIME" || { echo "divinus-multi: unsafe runtime directory" >&2; exit 1; }
    acquire_lock || exit 1
    stop_all || exit 1
    rm -f "$MANIFEST" "$RUNTIME/cameras.manifest.tmp.$$"
    ;;
 restart)
    "$0" stop || { echo "divinus-multi: restart aborted because stop failed" >&2; exit 1; }
    "$0" start
    ;;
 *) echo "Usage: $0 {start|stop|restart}" >&2; exit 1;;
esac
