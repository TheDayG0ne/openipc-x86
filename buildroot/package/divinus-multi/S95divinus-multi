#!/bin/sh
# Run one camera-independent Divinus WebUI/API process and camera workers without
# HTTP listeners. No reverse proxy is used: the central process serves static WebUI
# and the API directly; workers retain only their RTSP endpoints.

DAEMON=${DAEMON:-/usr/bin/divinus}
BASE=${BASE:-/var/lib/divinus-multi}
CONF=${CONF:-/etc/divinus-multi.conf}
PIDS=${PIDS:-/var/run/divinus-multi}
TEMPLATE=${TEMPLATE:-/etc/divinus.yaml}
RUNTIME=${RUNTIME:-/run/divinus}
MANIFEST=$RUNTIME/cameras.manifest

[ -r "$CONF" ] || exit 0
. "$CONF"

pidfile() { echo "$PIDS/$1.pid"; }
stop_one() {
    p=$(pidfile "$1")
    [ -r "$p" ] || return 0
    pid=$(cat "$p")
    kill "$pid" 2>/dev/null || true
    rm -f "$p"
}
validate_port() {
    name=$1; port=$2
    case "$port" in *[!0-9]*|'') echo "divinus-multi: invalid $name port" >&2; return 1;; esac
    [ "$port" -ge 1 ] 2>/dev/null && [ "$port" -le 65535 ] 2>/dev/null || { echo "divinus-multi: $name port out of range: $port" >&2; return 1; }
}
validate_config() {
    validate_port web "$MULTI_WEB_PORT" || return 1
    validate_port central-RTSP "$MULTI_RTSP_PORT_CENTRAL" || return 1
    ports="$MULTI_WEB_PORT $MULTI_RTSP_PORT_CENTRAL"
    devices=""
    i=1
    while [ "$i" -le "$count" ]; do
        eval "rtsp=\${MULTI_RTSP_PORT_$i}"
        [ -n "$rtsp" ] || rtsp=$((553 + i))
        validate_port "slot $i RTSP" "$rtsp" || return 1
        case " $ports " in *" $rtsp "*) echo "divinus-multi: duplicate port $rtsp" >&2; return 1;; esac
        ports="$ports $rtsp"
        eval "device=\${MULTI_DEVICE_$i-}"
        if [ -n "$device" ]; then
            case " $devices " in *" $device "*) echo "divinus-multi: duplicate device in slot $i: $device" >&2; return 1;; esac
            devices="$devices $device"
        fi
        i=$((i + 1))
    done
}
write_manifest() {
    tmp=$(mktemp "$RUNTIME/cameras.manifest.tmp.XXXXXX") || return 1
    i=1
    while [ "$i" -le "$count" ]; do
        eval "rtsp=\${MULTI_RTSP_PORT_$i}"
        [ -n "$rtsp" ] || rtsp=$((553 + i))
        printf 'slot=%s rtsp_port=%s\n' "$i" "$rtsp" >> "$tmp" || { rm -f "$tmp"; return 1; }
        i=$((i + 1))
    done
    chown 0:0 "$tmp" 2>/dev/null || true
    chmod 600 "$tmp" || { rm -f "$tmp"; return 1; }
    mv -f "$tmp" "$MANIFEST" || { rm -f "$tmp"; return 1; }
}
write_config() {
    dir=$1; web=$2; rtsp=$3; rtsp_enable=$4
    awk -v web="$web" -v rtsp="$rtsp" -v rtsp_enable="$rtsp_enable" '
        /^system:$/ { section="system" }
        /^rtsp:$/ { section="rtsp" }
        section == "system" && /^  web_port:/ { $0="  web_port: " web }
        section == "rtsp" && /^  enable:/ { $0="  enable: " rtsp_enable }
        section == "rtsp" && /^  port:/ { $0="  port: " rtsp }
        { print }
    ' "$TEMPLATE" > "$dir/divinus.yaml" || return 1
    cp "$DAEMON" "$dir/divinus" || return 1
}
start_central() {
    dir="$BASE/central"
    mkdir -p "$dir" "$PIDS" || return 1
    write_config "$dir" "${MULTI_WEB_PORT:-80}" "${MULTI_RTSP_PORT_CENTRAL:-554}" "false" || return 1
    # /dev/null is intentional: this process owns the dashboard/API, not a camera.
    UVC_DEVICE=/dev/null "$dir/divinus" >"$dir/divinus.log" 2>&1 &
    echo $! > "$(pidfile central)"
}
start_camera() {
    n=$1; dev=$2; web=$3; rtsp=$4
    [ -n "$rtsp" ] || rtsp=$((553 + n))
    if [ -z "$dev" ] || [ ! -c "$dev" ]; then
        echo "divinus-multi: camera $n absent ($dev), skipped" >&2
        return 0
    fi
    dir="$BASE/camera-$n"
    mkdir -p "$dir" "$PIDS" || return 1
    # web_port 0 is Divinus' documented no-listener mode; only RTSP is exposed.
    write_config "$dir" 0 "$rtsp" "true" || return 1
    UVC_DEVICE="$dev" "$dir/divinus" >"$dir/divinus.log" 2>&1 &
    echo $! > "$(pidfile "camera-$n")"
}

case "$1" in
 start)
    mkdir -p "$BASE" "$PIDS" "$RUNTIME" || exit 1
    count=${MULTI_CAMERAS:-0}; [ "$count" -ge 0 ] 2>/dev/null || { echo "divinus-multi: invalid camera count" >&2; exit 1; }
    [ "$count" -le 4 ] 2>/dev/null || { echo "divinus-multi: too many cameras" >&2; exit 1; }
    MULTI_WEB_PORT=${MULTI_WEB_PORT:-80}
    MULTI_RTSP_PORT_CENTRAL=${MULTI_RTSP_PORT_CENTRAL:-554}
    validate_config || exit 1
    write_manifest || exit 1
    start_central
    i=1
    while [ "$i" -le "$count" ]; do
        eval "dev=\${MULTI_DEVICE_$i}"; eval "rtsp=\${MULTI_RTSP_PORT_$i}"
        start_camera "$i" "$dev" "0" "$rtsp"
        i=$((i + 1))
    done
    ;;
 stop)
    stop_one central
    i=1; while [ "$i" -le 4 ]; do stop_one "camera-$i"; i=$((i + 1)); done
    rm -f "$MANIFEST" "$RUNTIME/cameras.manifest.tmp.$$"
    ;;
 restart) "$0" stop; sleep 1; "$0" start ;;
 *) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
 esac
