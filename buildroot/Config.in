config BR2_PACKAGE_DIVINUS_WEBUI
	bool "Divinus WebUI static files"
	help
	  Install the WebUI www tree for Divinus to serve.

config BR2_PACKAGE_X86_DIVINUS_FFMPEG
	bool "Divinus UVC FFmpeg support"
	depends on BR2_PACKAGE_DIVINUS
	select BR2_PACKAGE_FFMPEG
	select BR2_PACKAGE_FFMPEG_SWSCALE
	select BR2_PACKAGE_X264
	help
	  Build the local UVC-enabled Divinus with FFmpeg and x264.

config BR2_PACKAGE_DIVINUS_MULTI
	bool "Divinus multi-camera launcher (1-4 UVC devices)"
	depends on BR2_PACKAGE_DIVINUS
	help
	  Start independent Divinus processes for present UVC devices with distinct
	  web and RTSP ports. Missing devices are skipped; no camera is emulated.
